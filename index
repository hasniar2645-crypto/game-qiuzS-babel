<script>
/* ===== DATA SOAL (30 soal: 21 Multiple Choice + 9 Oral Answer) ===== */
const LV={1:'Mudah',2:'Sedang',3:'Menantang'};
const MC=[
["Jumlah pemain inti satu tim dalam pertandingan sepak bola resmi adalah …",["9 pemain","11 pemain","10 pemain","12 pemain"],1,"Satu tim memainkan 11 pemain, termasuk 1 penjaga gawang.",1],
["Bagian kaki yang paling tepat untuk mengoper bola jarak dekat agar akurat adalah …",["Ujung jari kaki","Tumit","Sisi dalam kaki","Lutut"],2,"Sisi dalam kaki permukaannya lebar dan rata sehingga arah operan lebih mudah dikontrol.",1],
["Bagian kaki yang digunakan untuk menendang bola jauh dan keras adalah …",["Sisi dalam kaki","Punggung kaki","Telapak kaki","Tumit"],1,"Punggung kaki (kura-kura) menghasilkan tenaga besar untuk tendangan jauh dan keras.",1],
["Tujuan utama menghentikan bola (stopping) adalah …",["Menjauhkan bola dari diri sendiri","Menghabiskan waktu permainan","Mengoper bola secepat mungkin","Mengontrol bola agar mudah dikuasai"],3,"Menghentikan bola membuat bola terkendali sehingga mudah dioper, digiring, atau ditembakkan.",1],
["Cara menggiring bola (dribbling) yang benar adalah …",["Bola disentuh ringan dan dekat kaki, kepala sesekali melihat sekitar","Bola ditendang jauh lalu dikejar","Memandang bola terus-menerus tanpa melihat sekitar","Bola disentuh dengan tenaga penuh setiap langkah"],0,"Sentuhan ringan menjaga bola tetap dekat; melihat sekitar membantu membaca posisi lawan dan teman.",2],
["Lama waktu pertandingan sepak bola resmi orang dewasa adalah …",["2 x 30 menit","2 x 40 menit","2 x 45 menit","4 x 15 menit"],2,"Pertandingan resmi berlangsung dua babak, masing-masing 45 menit.",1],
["Teknik menyundul bola yang benar menggunakan …",["Ubun-ubun dengan mata tertutup","Dahi dengan mata terbuka dan leher tegang","Pelipis sambil menunduk","Belakang kepala sambil menarik leher"],1,"Dahi adalah bagian keras yang aman; mata terbuka dan leher tegang membantu arah bola dan mencegah cedera.",2],
["Pemain (bukan kiper) sengaja memegang bola dengan tangan. Akibatnya adalah …",["Tendangan bebas untuk tim lawan","Lemparan ke dalam","Tendangan gawang","Permainan lanjut tanpa sanksi"],0,"Handball yang disengaja adalah pelanggaran dan dihukum tendangan bebas bagi lawan.",2],
["Lawan jatuh kesakitan akibat benturan. Sikap sportif yang tepat adalah …",["Menertawakannya","Tetap menyerang tanpa peduli","Pura-pura tidak melihat","Menanyakan kondisinya dan menghentikan permainan jika diperlukan"],3,"Sportivitas berarti peduli pada keselamatan dan menghormati lawan.",1],
["Kamu dijaga ketat, sedangkan temanmu bebas di depan gawang. Tindakan kerja sama yang tepat adalah …",["Menembak paksa dari posisi sulit","Menahan bola sendiri","Mengoper bola kepada teman yang bebas","Memarahi teman agar bergerak"],2,"Kerja sama berarti memilih opsi terbaik bagi tim, yaitu mengoper ke teman yang berpeluang mencetak gol.",2],
["Tugas utama penjaga gawang adalah …",["Hanya membantu menyerang","Mencegah bola masuk gawang dan membantu mengatur pertahanan","Mengambil lemparan ke dalam saja","Menjadi wasit cadangan"],1,"Kiper menjaga gawang dan, dengan posisi pandang luas, membantu mengarahkan barisan bertahan.",1],
["Tendangan gawang diberikan jika …",["Bola keluar garis samping","Terjadi pelanggaran di area penalti","Bola melewati garis gawang tanpa gol setelah terakhir disentuh penyerang","Bola disentuh terakhir oleh pemain bertahan lalu keluar garis gawang"],2,"Bila bola keluar lewat garis gawang setelah terakhir disentuh tim penyerang, penjaga gawang melakukan tendangan gawang.",3],
["Pemain dinyatakan offside jika saat bola dioper kepadanya …",["Berada di belakang bola","Berada di area lawan, lebih dekat ke garis gawang lawan daripada bola dan pemain bertahan kedua terakhir","Menerima lemparan ke dalam dekat gawang","Menembak dari luar kotak penalti"],1,"Offside dinilai saat bola dioper: penyerang di area lawan lebih dekat ke garis gawang lawan daripada bola dan bek kedua terakhir.",3],
["Tujuan utama melakukan pemanasan sebelum bermain adalah …",["Membuat cepat lelah","Menghabiskan waktu","Mengurangi jumlah pemain","Menyiapkan otot dan sendi serta mengurangi risiko cedera"],3,"Pemanasan meningkatkan suhu otot dan fleksibilitas sehingga tubuh siap dan risiko cedera berkurang.",1],
["Saat tim kehilangan bola, tindakan bertahan yang paling tepat adalah …",["Segera menutup ruang dan kembali ke posisi bertahan bersama tim","Diam menunggu di tempat","Semua pemain mengejar bola sendiri-sendiri","Berjalan keluar lapangan"],0,"Bertahan efektif dilakukan bersama: menutup ruang, menjaga lawan, dan kembali ke posisi.",2],
["Kartu kuning dari wasit menandakan …",["Pemain dikeluarkan dari lapangan","Pemain mendapat hadiah","Pemain mendapat peringatan atas pelanggarannya","Pemain diganti"],2,"Kartu kuning adalah peringatan; kartu merah berarti pemain dikeluarkan.",1],
["Cara melakukan lemparan ke dalam yang benar adalah …",["Satu tangan sambil berlari","Dua tangan dari belakang kepala dengan kedua kaki tetap menyentuh tanah","Menggunakan kaki dari garis samping","Dari depan dada sambil melompat dengan kedua kaki lepas tanah"],1,"Lemparan ke dalam sah bila memakai dua tangan, bola dari belakang kepala ke depan, dan sebagian kedua kaki tetap menyentuh tanah.",2],
["Setelah timmu menang, sikap karakter yang baik adalah …",["Menyalami lawan dan menghargai usaha mereka","Mengejek tim lawan","Menyalahkan wasit","Pergi tanpa bersalaman"],0,"Menghargai lawan setelah pertandingan adalah wujud sportivitas dan sikap rendah hati.",1],
["Pada formasi 4-3-3 (bek-gelandang-penyerang), jumlah gelandang adalah …",["4 pemain","3 pemain","2 pemain","1 pemain"],1,"Angka tengah menunjukkan gelandang, yaitu 3 pemain.",2],
["Agar tembakan sulit dihentikan kiper, sebaiknya bola diarahkan …",["Tepat ke tubuh kiper","Tinggi ke atas tribun","Akurat ke sudut gawang yang jauh dari jangkauan kiper","Pelan ke tengah gawang"],2,"Penempatan bola ke sudut yang jauh dari jangkauan kiper meningkatkan peluang gol.",3],
["Kamu kurang setuju dengan keputusan wasit. Sikap yang tepat adalah …",["Memprotes ramai-ramai","Meninggalkan lapangan","Membalas dengan pelanggaran","Menerima keputusan, kapten menanyakan dengan sopan jika perlu"],3,"Keputusan wasit harus dihormati; komunikasi dilakukan dengan sopan melalui kapten.",3]
];
const OR=[
["Sebutkan dan jelaskan tiga keterampilan gerak dasar dalam sepak bola!",["Menyebut minimal tiga teknik (mengoper, menghentikan, menggiring, menendang, menyundul, melempar ke dalam)","Menjelaskan fungsi atau cara tiap teknik secara singkat","Menggunakan istilah yang tepat"],"Mengoper (passing) memindahkan bola ke teman memakai sisi dalam kaki; menghentikan (stopping) mengontrol bola yang datang; menggiring (dribbling) membawa bola dekat kaki sambil melihat sekitar.","Keterampilan dasar menjadi fondasi bermain sepak bola yang baik dan kerja sama tim.",1],
["Jelaskan langkah-langkah mengoper bola dengan sisi dalam kaki!",["Kaki tumpu diletakkan di samping bola","Sisi dalam kaki kayuh mengenai bagian tengah bola","Pandangan ke sasaran dan ayunan dilanjutkan ke arah sasaran"],"Letakkan kaki tumpu di samping bola, ayunkan kaki dengan sisi dalam mengenai tengah bola, mata ke sasaran, ikuti arah dengan ayunan lanjutan.","Teknik yang benar menghasilkan operan akurat dan terkontrol.",2],
["Mengapa kerja sama tim penting dalam sepak bola? Berikan satu contoh nyata!",["Menyebut kerja sama saling melengkapi peran","Memberi contoh nyata (mengoper, menutup ruang, berkomunikasi)","Menyebut dampaknya pada hasil atau suasana tim"],"Karena sepak bola dimainkan 11 orang yang saling melengkapi; contohnya saling mengoper dan berkomunikasi agar peluang gol lebih besar dan tim solid.","Kerja sama membuat strategi berjalan dan menumbuhkan rasa saling percaya.",2],
["Jelaskan dengan bahasamu sendiri apa yang dimaksud posisi offside!",["Penyerang di area lawan lebih dekat ke garis gawang lawan daripada bola dan bek kedua terakhir","Dinilai pada saat bola dioper kepada penyerang","Akibatnya tendangan bebas tidak langsung untuk lawan"],"Offside terjadi saat bola dioper dan penyerang berada di area lawan lebih dekat ke garis gawang daripada bola dan bek kedua terakhir; hukumannya tendangan bebas tidak langsung bagi lawan.","Aturan offside menjaga permainan tetap adil.",3],
["Berikan contoh sikap sportif sebelum, selama, dan sesudah pertandingan!",["Sebelum: menghormati lawan, wasit, dan aturan","Selama: bermain jujur, tidak kasar, menolong lawan yang cedera","Sesudah: menerima hasil dan bersalaman"],"Sebelum: berjabat tangan dan siap mematuhi aturan. Selama: bermain jujur dan tidak kasar. Sesudah: menerima kalah atau menang dengan lapang dada dan bersalaman.","Sportivitas adalah nilai karakter utama olahraga.",1],
["Jelaskan cara menggiring bola (dribbling) yang benar!",["Sentuhan ringan dengan punggung atau sisi kaki","Bola tetap dekat kaki","Kepala sesekali tegak melihat lawan dan teman","Mengubah arah dan kecepatan sesuai situasi"],"Sentuh bola ringan dengan punggung atau sisi kaki, jaga dekat kaki, sesekali angkat kepala melihat lawan dan teman, ubah arah dan kecepatan.","Dribbling yang baik menjaga penguasaan bola.",2],
["Jelaskan strategi bertahan bersama tim ketika lawan menyerang!",["Menutup ruang dan menjaga lawan","Berkomunikasi antar pemain","Menjaga jarak dan formasi atau kembali ke posisi","Tidak semua pemain mengejar bola"],"Pemain menutup ruang dan menjaga lawan, saling berkomunikasi, menjaga jarak dan formasi, serta tidak semua mengejar bola sehingga pertahanan tetap rapat.","Pertahanan efektif adalah tugas seluruh tim.",3],
["Jelaskan apa saja yang dilakukan saat pemanasan dan pendinginan serta manfaatnya!",["Pemanasan: lari ringan dan peregangan dinamis","Manfaat pemanasan: menyiapkan otot dan mencegah cedera","Pendinginan: gerak ringan dan peregangan untuk pemulihan"],"Pemanasan berupa lari ringan dan peregangan dinamis agar otot siap dan tidak cedera; pendinginan berupa jalan pelan dan peregangan agar tubuh pulih.","Pemanasan dan pendinginan menjaga kesehatan dan performa.",2],
["Temanmu melakukan kesalahan sehingga lawan mencetak gol. Apa yang kamu lakukan dan katakan?",["Tidak menyalahkan atau mengejek","Memberi semangat dan dukungan","Mengajak mencari solusi bersama dan tetap fokus"],"Saya tidak menyalahkan; saya berkata 'tidak apa-apa, ayo kita balas bersama' lalu mengajak berdiskusi memperbaiki posisi.","Dukungan membuat tim tetap solid dan percaya diri.",2]
];
const POS=[4,7,10,13,17,20,24,27,30],N=30;
const Q=[];{let m=0,o=0;for(let i=1;i<=N;i++){if(POS.includes(i)){const r=OR[o++];Q.push({id:i,t:'oral',q:r[0],ind:r[1],ref:r[2],ex:r[3],lv:r[4]})}else{const r=MC[m++];Q.push({id:i,t:'mc',q:r[0],opt:r[1],key:r[2],ex:r[3],lv:r[4]})}}}
console.assert(Q.length===N&&MC.length===21&&OR.length===9,'Jumlah soal tidak sesuai');

/* ===== STATE ===== */
const $=s=>document.querySelector(s),L='ABCD';
const esc=t=>String(t).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
let S,cur=null,B=[],last=0,lastBtn=null,showEnd=false;
const newS=()=>Q.map(()=>({st:'open',resp:'',pick:null,pts:null,chk:[]}));
function info(i){const s=S[i];if(s.st==='open')return['','Belum dikerjakan',''];if(s.st==='pend')return['⏳','Menunggu penilaian guru','pend'];return s.pts===100?['✓','Benar','ok']:s.pts===50?['◐','Sebagian benar','part']:['✗','Salah','no']}
function stats(){const d=S.filter(s=>s.st==='done');return{done:d.length,ben:d.filter(s=>s.pts===100).length,sal:d.filter(s=>s.pts===0).length,par:d.filter(s=>s.pts===50).length,pen:S.filter(s=>s.st==='pend').length,pts:d.reduce((a,s)=>a+s.pts,0)}}
const complete=()=>S.every(s=>s.st==='done');

/* ===== BOLA ===== */
const arena=$('#arena');
Q.forEach((q,i)=>{const b=document.createElement('button');b.className='ball';b.style.setProperty('--h',Math.round(i*360/N*1.0));b.innerHTML=`<b>${q.id}</b><i aria-hidden="true"></i>`;b.onclick=()=>openQ(i,b);
b.onmouseenter=b.onfocus=()=>o.hold=true;b.onmouseleave=b.onblur=()=>o.hold=false;
b.ontouchstart=()=>o.hold=true;b.ontouchend=()=>setTimeout(()=>o.hold=false,400);
const o={el:b,x:0,y:0,vx:0,vy:0,hold:false};B.push(o);arena.appendChild(b)});
function place(){const w=arena.clientWidth,h=arena.clientHeight,z=B[0].el.offsetWidth||54;B.forEach(b=>{b.x=Math.random()*(w-z);b.y=Math.random()*(h-z);const a=Math.random()*6.283,v=45+Math.random()*55;b.vx=Math.cos(a)*v;b.vy=Math.sin(a)*v})}
function tick(t){const dt=Math.min(.05,(t-last)/1000||0);last=t;const w=arena.clientWidth,h=arena.clientHeight,z=B[0].el.offsetWidth;
B.forEach(b=>{if(!b.hold&&!RM){b.x+=b.vx*dt;b.y+=b.vy*dt}
if(b.x<0){b.x=0;b.vx=Math.abs(b.vx)}else if(b.x>w-z){b.x=Math.max(0,w-z);b.vx=-Math.abs(b.vx)}
if(b.y<0){b.y=0;b.vy=Math.abs(b.vy)}else if(b.y>h-z){b.y=Math.max(0,h-z);b.vy=-Math.abs(b.vy)}
b.el.style.transform=`translate(${b.x}px,${b.y}px)`});requestAnimationFrame(tick)}

/* ===== UI ===== */
function ui(){const t=stats(),pg=Math.round(t.done/N*100);
$('#sA').textContent=`${t.done} / ${N}`;$('#sB').textContent=t.ben;$('#sS').textContent=t.sal;$('#sP').textContent=t.par;$('#sW').textContent=t.pen;$('#sN').textContent=`${t.pts} / ${N*100}`;$('#sG').textContent=pg+'%';$('#bar').style.width=pg+'%';
B.forEach((b,i)=>{const f=info(i);b.el.className='ball '+f[2]+(cur===i?' sel':'');b.el.querySelector('i').textContent=f[0];b.el.setAttribute('aria-label',`Bola ${i+1}, ${Q[i].t==='mc'?'Multiple Choice':'Oral Answer'}, ${f[1]}`)});
$('#rBtn').style.display=complete()?'':'none';teacher()}
function openQ(i,btn){cur=i;lastBtn=btn||B[i].el;render();$('#ov').classList.add('on');$('#modal').focus();ui()}
function closeQ(){$('#ov').classList.remove('on');cur=null;ui();if(lastBtn)lastBtn.focus();afterClose()}
function afterClose(){if(complete()&&!showEnd&&!$('#ov').classList.contains('on')){showEnd=true;final()}}
function tags(q){return`<div class="tags"><span class="tag">Soal ${q.id}</span><span class="tag">${q.t==='mc'?'Multiple Choice':'Oral Answer'}</span><span class="tag">${LV[q.lv]}</span></div>`}
function tts(i){try{speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(Q[i].q);u.lang='id-ID';speechSynthesis.speak(u)}catch(e){}}
function render(){const q=Q[cur],s=S[cur],m=$('#mbody');let h=tags(q)+`<h2 id="qt">${q.q}</h2>`;
if('speechSynthesis'in window&&s.st!=='done')h+=`<button class="btn sec" onclick="tts(${cur})">🔊 Bacakan Soal</button>`;
if(q.t==='mc')h+=s.st==='open'?mcOpen(q,s):mcDone(q,s);else h+=s.st==='done'?orDone(q,s):orOpen(q,s);
m.innerHTML=h}
function mcOpen(q,s){return`<fieldset style="border:0;padding:0;margin:0"><legend class="small">Pilih satu jawaban:</legend>${q.opt.map((o,i)=>`<label class="opt"><input type="radio" name="o" ${s.pick===i?'checked':''} onchange="pick(${i})"><span><b>${L[i]}.</b> ${o}</span></label>`).join('')}</fieldset><div class="row"><button class="btn" id="cf" ${s.pick===null?'disabled':''} onclick="confirmMC()">Konfirmasi Jawaban</button><button class="btn sec" onclick="closeQ()">Tutup</button></div>`}
function pick(i){const s=S[cur];if(s.st!=='open')return;s.pick=i;$('#cf').disabled=false}
function confirmMC(){const s=S[cur],q=Q[cur];if(s.st!=='open'||s.pick===null)return;s.pts=s.pick===q.key?100:0;s.st='done';render();ui();$('#modal').scrollTop=0}
function mcDone(q,s){const ok=s.pts===100;return q.opt.map((o,i)=>`<div class="opt ${i===q.key?'ok':i===s.pick?'no':''}"><span><b>${L[i]}.</b> ${o} ${i===q.key?'<b>✓ Jawaban benar</b>':i===s.pick?'<b>✗ Pilihanmu</b>':''}</span></div>`).join('')+
`<div class="fb ${ok?'ok':'no'}"><h3>${ok?'✓ Hebat! Jawabanmu benar. (+100 poin)':'✗ Belum tepat, tidak apa-apa! Jawaban yang benar: '+L[q.key]+'. (+0 poin)'}</h3><div><b>Pembahasan:</b> ${q.ex}</div></div><div class="row"><button class="btn" onclick="closeQ()">Tutup</button></div>`}
const rub=q=>`<ul class="cl"><li><b>100 – Sangat tepat:</b> semua atau hampir semua indikator terpenuhi dengan penjelasan benar.</li><li><b>50 – Cukup tepat:</b> sebagian indikator terpenuhi / jawaban benar tetapi kurang lengkap.</li><li><b>0 – Belum tepat:</b> hampir tidak ada indikator terpenuhi atau konsep keliru.</li></ul>`;
function orOpen(q,s){let h=`<p class="small">Jawab secara lisan kepada guru atau tuliskan jawaban di bawah ini (opsional sebagai catatan).</p><label for="rs" class="small">Catatan respons siswa:</label><textarea id="rs" oninput="S[cur].resp=this.value" ${s.st==='pend'?'':''}>${esc(s.resp)}</textarea>`;
if(s.st==='open')h+=`<div class="row"><button class="btn" onclick="openGrade()">Buka Penilaian Guru</button><button class="btn sec" onclick="closeQ()">Tutup</button></div>`;
else h+=`<div class="fb pend"><h3>⏳ Panel Penilaian Guru</h3><p class="small">Centang indikator yang terpenuhi, pilih kategori, lalu konfirmasi. Nilai baru tercatat setelah dikonfirmasi.</p><b>Indikator jawaban:</b><ul class="cl nb">${q.ind.map((x,i)=>`<li><label><input type="checkbox" class="ck" value="${i}" ${s.chk.includes(i)?'checked':''}> ${x}</label></li>`).join('')}</ul><b>Contoh jawaban acuan:</b><p>${q.ref}</p><b>Rubrik:</b>${rub()}<fieldset style="border:0;padding:0"><legend><b>Kategori penilaian:</b></legend><label class="opt"><input type="radio" name="g" value="100" onchange="gSel()"> 100 – Sangat tepat</label><label class="opt"><input type="radio" name="g" value="50" onchange="gSel()"> 50 – Cukup tepat</label><label class="opt"><input type="radio" name="g" value="0" onchange="gSel()"> 0 – Belum tepat</label></fieldset><div class="row"><button class="btn" id="gc" disabled onclick="grade()">Konfirmasi Penilaian</button><button class="btn sec" onclick="closeQ()">Tutup (nilai belum dicatat)</button></div></div>`;
return h}
function openGrade(){const s=S[cur];if(s.st==='open'){s.st='pend'}render();ui()}
function gSel(){$('#gc').disabled=false}
function grade(){const s=S[cur];if(s.st!=='pend')return;const r=document.querySelector('input[name=g]:checked');if(!r)return;s.chk=[...document.querySelectorAll('.ck:checked')].map(x=>+x.value);s.pts=+r.value;s.st='done';render();ui();$('#modal').scrollTop=0}
function orDone(q,s){const f=info(cur);return`<div class="fb ${f[2]}"><h3>${f[0]} Hasil penilaian guru: ${f[1]} (+${s.pts} poin)</h3><p>${s.pts===100?'Luar biasa! Jawabanmu sangat tepat.':s.pts===50?'Bagus, kamu sudah berada di jalur yang benar. Lengkapi bagian yang masih kurang ya!':'Tidak apa-apa, ini kesempatan belajar. Perhatikan jawaban acuan di bawah.'}</p><b>Indikator:</b><ul class="cl nb">${q.ind.map((x,i)=>`<li>${s.chk.includes(i)?'✓ Terpenuhi':'✗ Perlu diperbaiki'} – ${x}</li>`).join('')}</ul><b>Jawaban acuan:</b><p>${q.ref}</p><b>Pembahasan:</b> ${q.ex}${s.resp?`<p><b>Catatan respons siswa:</b> ${esc(s.resp)}</p>`:''}</div><div class="row"><button class="btn" onclick="closeQ()">Tutup</button></div>`}

/* ===== PANEL GURU ===== */
function teacher(){const t=stats(),el=$('#teacher');
const fin=complete()?`Nilai akhir: <b>${Math.max(0,Math.min(100,Math.round(t.pts/(N*100)*100)))}</b> / 100`:`Hasil final belum tersedia: ${N-t.done} soal belum selesai (${t.pen} menunggu penilaian)`;
el.innerHTML=`<h2 style="margin-top:0">Panel Guru – PJOK Sepak Bola, Kelas VII</h2><p>Selesai: <b>${t.done}/${N}</b> · Menunggu penilaian: <b>${t.pen}</b> · Total poin: <b>${t.pts}</b> · ${fin}</p><div class="row" style="margin:0 0 8px"><button class="btn sec" onclick="window.print()">🖨 Cetak Ringkasan</button></div>`+
Q.map((q,i)=>{const f=info(i),s=S[i];return`<details ${s.st==='pend'?'open':''}><summary>No. ${q.id} · ${q.t==='mc'?'Multiple Choice':'Oral Answer'} · ${f[0]} ${f[1]} · Skor: ${s.pts===null?'-':s.pts}</summary><div class="small"><p>${q.q}</p>${q.t==='mc'?`<p>Kunci: <b>${L[q.key]}</b> – ${q.opt[q.key]}</p><p>Rubrik: benar 100, salah 0.</p>`:`<p><b>Indikator:</b></p><ul class="cl">${q.ind.map(x=>`<li>${x}</li>`).join('')}</ul>${rub()}`}<button class="btn sec" onclick="openQ(${i})">${s.st==='done'?'Lihat Ringkasan':s.st==='pend'?'Buka & Nilai':'Buka Soal'}</button></div></details>`}).join('')}
$('#tBtn').onclick=()=>{const e=$('#teacher'),on=e.classList.toggle('on');$('#tBtn').setAttribute('aria-expanded',on);if(on)e.scrollIntoView({behavior:RM?'auto':'smooth'})};

/* ===== HASIL AKHIR ===== */
function final(){if(!complete()){return}const t=stats(),nv=Math.max(0,Math.min(100,Math.round(t.pts/(N*100)*100)));
$('#mbody').innerHTML=`<div class="big"><h2 id="qt" style="font-size:1.7rem">🏆 BounceQuiz Selesai!</h2><div class="score">${nv}</div><div class="small">Nilai Akhir (skala 0–100)</div></div><div class="sum"><div>Jumlah soal: <b>${N}</b></div><div>Jawaban benar: <b>${t.ben}</b></div><div>Jawaban salah: <b>${t.sal}</b></div><div>Sebagian benar (Oral 50): <b>${t.par}</b></div><div>Multiple Choice: <b>${Q.filter(q=>q.t==='mc').length}</b></div><div>Oral Answer: <b>${Q.filter(q=>q.t==='oral').length}</b></div><div>Total poin: <b>${t.pts} / ${N*100}</b></div><div>Penyelesaian: <b>${Math.round(t.done/N*100)}%</b></div></div><p class="small">Nilai Akhir = (Total Poin ÷ Poin Maksimum) × 100</p><div class="row" style="justify-content:center"><button class="btn" onclick="resetGame()">Main Lagi</button><button class="btn sec" onclick="window.print()">🖨 Cetak</button><button class="btn sec" onclick="closeFinal()">Tutup</button></div>`;
cur=null;$('#ov').classList.add('on');$('#modal').focus()}
function closeFinal(){$('#ov').classList.remove('on');$('#rBtn').focus()}
$('#rBtn').onclick=final;
function resetGame(){S=newS();cur=null;showEnd=false;$('#ov').classList.remove('on');place();ui();window.scrollTo({top:0})}
$('#resetBtn').onclick=()=>{if(S.some(s=>s.st!=='open')&&!confirm('Mulai sesi baru? Semua progres, respons, dan nilai akan direset.'))return;resetGame()};
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&$('#ov').classList.contains('on')){cur===null?closeFinal():closeQ()}});
$('#ov').addEventListener('click',e=>{if(e.target.id==='ov'){cur===null?closeFinal():closeQ()}});
S=newS();place();ui();requestAnimationFrame(tick);
</script>
</body>
</html>
